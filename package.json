{
  "name": "fixlinks",
  "productName": "FixLinks",
  "version": "1.4.0",
  "description": "FixLinks converts copied social-post links into Discord-friendly embed links.",
  "author": "FixLinks contributors",
  "license": "0BSD",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint --error-on-warnings .",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "verify:release": "node scripts/verify-release.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist-test/test/*.test.js test/*.test.mjs",
    "test:installed": "npm run package && node scripts/test-installed-updates.mjs",
    "start": "npm run build && electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "electron-store": "11.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "24.13.3",
    "electron": "44.10.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
